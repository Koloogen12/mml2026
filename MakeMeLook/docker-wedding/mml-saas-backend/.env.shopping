# =============================================================================
# .env.shopping — config for backend deployed to b2b.makemelook.ai/shopping
# Copied into the backend image as /app/.env at build time.
# =============================================================================

# Application
APP_ENV=production
LOG_LEVEL=info
SERVER_PORT=3010

# Database — internal docker network hostname
DB_HOST=postgres
DB_PORT=5432
DB_NAME=makemelook
DB_USER=makemelook
DB_PASSWORD=makemelook
DB_LOG_LEVEL=warn

# Minio — internal endpoint; public URL goes through host nginx
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=makemelook
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://b2b.makemelook.ai/shopping-s3

# JWT — real random for production
JWT_SECRET=mml-shopping-demo-jwt-secret-32-chars-min-XXXXXXXX
JWT_ACCESS_EXP_MINUTES=60
JWT_REFRESH_EXP_DAYS=30

# Widget CDN — served at /shopping-widget by host nginx
WIDGET_CDN_URL=https://b2b.makemelook.ai/shopping-widget/widget

# CORS — only allow the deployed host
CORS_ALLOWED_ORIGINS=https://b2b.makemelook.ai

# OAuth — not used on this public demo
GOOGLE_OAUTH_CLIENT_ID=111074965785-ghumrfmrqko74jbcqmpisp7481p167mi.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
YANDEX_OAUTH_CLIENT_ID=33d3c28452c545c29ee1774d6f1a086f
YANDEX_OAUTH_CLIENT_SECRET=21d9376477354b6e8cad7a9c12e97b74
OAUTH_BASE_URL=https://b2b.makemelook.ai/shopping-api

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gemini — try-on API (same keys as local demo)
GEMINI_API_KEY=AIzaSyCrbA_PuywXlPL3ZKWLtkLRJzPl39H2yL8
GEMINI_TRYON_MODEL=gemini-3-pro-image-preview
GEMINI_TIMEOUT_SEC=300
GEMINI_MAX_RETRIES=3

# Route Gemini traffic through our own `ss-proxy` sidecar (sslocal-rust in
# HTTP-tunnel mode). Matches the proxy wiring in main-repo commit 0fe229033c.
AI_PROXY_URL=http://ss-proxy:10808

# CometAPI legacy (kept for compatibility)
COMET_API_URL=https://api.cometapi.com/v1
COMET_API_KEY=AIzaSyCrbA_PuywXlPL3ZKWLtkLRJzPl39H2yL8
COMET_API_TRYON_MODEL=gemini-3-pro-image-preview
