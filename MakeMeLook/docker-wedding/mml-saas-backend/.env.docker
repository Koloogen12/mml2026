# =============================================================================
# .env.docker — config for running backend inside docker-compose.local.yml
# Copied into the image as /app/.env at build time.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=debug
SERVER_PORT=3010

# Database — hostname = docker-compose service name
DB_HOST=postgres
DB_PORT=5432
DB_NAME=makemelook
DB_USER=makemelook
DB_PASSWORD=makemelook
DB_LOG_LEVEL=warn

# Minio — hostname = docker-compose service name; public URL is what the browser sees
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=makemelook
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9010

# JWT
JWT_SECRET=local-dev-secret-key-change-in-production-32chars
JWT_ACCESS_EXP_MINUTES=60
JWT_REFRESH_EXP_DAYS=30

# CometAPI (legacy, try-on) — keep key from original .env so try-on still works if ключ валиден
COMET_API_URL=https://api.cometapi.com/v1
COMET_API_KEY=AIzaSyCrbA_PuywXlPL3ZKWLtkLRJzPl39H2yL8
COMET_API_TRYON_MODEL=gemini-3-pro-image-preview

# Widget CDN — served by the `widget` container
WIDGET_CDN_URL=http://localhost:4173/widget

# CORS — allow shop (8080), widget (4173), default Vite dev (5173, 5174)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4173,http://localhost:5173,http://localhost:5174

# OAuth — not used in the local wedding demo but fields are validated on load
GOOGLE_OAUTH_CLIENT_ID=111074965785-ghumrfmrqko74jbcqmpisp7481p167mi.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
YANDEX_OAUTH_CLIENT_ID=33d3c28452c545c29ee1774d6f1a086f
YANDEX_OAUTH_CLIENT_SECRET=21d9376477354b6e8cad7a9c12e97b74
OAUTH_BASE_URL=http://localhost:3010

# SMTP — empty = emails logged to stdout in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gemini
GEMINI_API_KEY=AIzaSyCrbA_PuywXlPL3ZKWLtkLRJzPl39H2yL8
GEMINI_TRYON_MODEL=gemini-3-pro-image-preview
GEMINI_TIMEOUT_SEC=300
GEMINI_MAX_RETRIES=3
