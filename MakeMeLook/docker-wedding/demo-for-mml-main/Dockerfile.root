# syntax=docker/dockerfile:1.6
# demo-for-mml (витрина-стенд) — Vite build, отдаётся nginx в КОРНЕ домена
# demo.makemelook.tech (в отличие от docker/Dockerfile, который вешает
# витрину на префикс /shop/).
FROM node:22-alpine AS build

ARG VITE_API_URL=https://admin.makemelook.tech
ARG VITE_PROJECT_ID
ARG VITE_WIDGET_URL=https://widget.makemelook.tech
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_PROJECT_ID=${VITE_PROJECT_ID} \
    VITE_WIDGET_URL=${VITE_WIDGET_URL}

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund --loglevel=error
COPY . .

# Перенацеливаем встроенный <script> виджета на прод-домены. Правится только
# копия внутри контейнера.
RUN sed -i \
      -e "s|src=\"[^\"]*loader\.js\"|src=\"${VITE_WIDGET_URL}/loader.js\"|g" \
      -e "s|data-api=\"[^\"]*\"|data-api=\"${VITE_API_URL}\"|g" \
      -e "s|data-cdn=\"[^\"]*\"|data-cdn=\"${VITE_WIDGET_URL}\"|g" \
      -e "s|data-project=\"[^\"]*\"|data-project=\"${VITE_PROJECT_ID}\"|g" \
      index.html \
 && grep -A5 "MakeMeLook widget" index.html

RUN npm run build -- --base=/ && ls -la dist

FROM nginx:1.27-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY docker/nginx.root.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
