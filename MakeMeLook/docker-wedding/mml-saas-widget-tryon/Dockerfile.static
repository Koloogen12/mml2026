# syntax=docker/dockerfile:1.6
# ============================================================================
# mml-saas-widget-tryon — static build served by nginx.
# Produces /widget/loader.js, /widget/widget.js, /widget/widget.css
# Served with permissive CORS so shop on :8080 can load it from :4173.
# ============================================================================

# ---------- Stage 1: build ----------
FROM node:22-alpine AS build

WORKDIR /app

# Dependencies (cached when package*.json not changed)
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund --loglevel=error

# Source
COPY . .

# Build widget.js + widget.css + loader.js into ./dist
RUN npm run build:widget \
 && npm run build:loader \
 && ls -la dist

# ---------- Stage 2: runtime ----------
FROM nginx:1.27-alpine

# Put widget files under /widget/... so the URL matches
# http://localhost:4173/widget/loader.js
RUN mkdir -p /usr/share/nginx/html/widget
COPY --from=build /app/dist/ /usr/share/nginx/html/widget/

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
