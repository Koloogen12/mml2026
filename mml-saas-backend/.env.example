# Application
APP_ENV=development
LOG_LEVEL=debug
SERVER_PORT=8080

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=makemelook
DB_USER=makemelook
DB_PASSWORD=your_password_here
DB_LOG_LEVEL=warn

# Minio (S3)
MINIO_ENDPOINT=127.0.0.1:9010
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=makemelook
MINIO_USE_SSL=false
# Public URL for serving assets (via nginx /s3/ proxy)
# Production: https://mml-saas.quantimo.ru/s3
# Or direct CDN: https://s3.makemelook.ai
MINIO_PUBLIC_URL=https://mml-saas.quantimo.ru/s3

# Credential vault master keyset.
# Wraps the per-project data keys that encrypt merchant acquiring, fiscal,
# delivery and inventory credentials. Empty = vault disabled, connecting a
# provider is refused rather than storing keys in the clear.
#
# Format: <version>:<base64-32-bytes>, comma-separated for rotation.
# The highest version encrypts new data; older versions stay listed until the
# rotation job has rewrapped every project.
#
# Generate straight into .env without ever displaying the value:
#   printf 'CREDENTIAL_KEYSET=1:%s\n' "$(head -c 32 /dev/urandom | base64)" >> .env
#
# Store the production value in the secrets manager, never beside a database
# dump — the key is the one thing that must not live where the ciphertext does.
CREDENTIAL_KEYSET=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=60

# Gemini API (try-on via Google AI)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_TRYON_MODEL=gemini-2.0-flash-exp-image-generation
# Fallback try-on model used when the primary model exhausts all retries
# (e.g. Nano Banana Pro 503). Set empty to disable fallback.
GEMINI_TRYON_FALLBACK_MODEL=gemini-2.5-flash-image
GEMINI_TIMEOUT_SEC=300
GEMINI_MAX_RETRIES=3

# AI Proxy (optional — route Gemini API calls through HTTP/SOCKS5 proxy)
# Example: http://user:pass@proxy.example.com:3128
# Leave empty to connect directly
AI_PROXY_URL=

# CometAPI — one key, two try-on paths. The default provider is now
# 'cometapi-gptimage' (GPT Image 2.5, see below); 'cometapi-gemini' routes
# Gemini image generation through the same account and stays as the
# cross-provider fallback. CometAPI is used for both because it is the only
# known gateway that reaches these models reliably from Russian networks.
# Get your key at: https://www.cometapi.com (account → API keys)
COMETAPI_KEY=
COMETAPI_BASE_URL=https://api.cometapi.com
COMETAPI_GEMINI_MODEL=gemini-2.5-flash-image
# Comma-separated fallback chain when the primary returns IMAGE_SAFETY /
# IMAGE_OTHER. Each next model is more permissive (and pricier).
COMETAPI_GEMINI_SAFETY_MODELS=gemini-3.1-flash-image-preview,gemini-3-pro-image-preview

# GPT Image 2.5 through CometAPI — the DEFAULT try-on path
# (project.tryon_provider = 'cometapi-gptimage'). Same key as above.
# Sunburst is primary on purpose: Flare's moderation blocked 4 of 8 identical
# requests on a lace/sequin dress, Sunburst passed 6 of 6, and both bill the
# same. Flare stays as the retry step; if the whole chain fails the dispatcher
# falls back to cometapi-gemini.
COMETAPI_GPTIMAGE_MODEL=gpt-image-2.5-sunburst
COMETAPI_GPTIMAGE_FALLBACK_MODELS=gpt-image-2.5-flare
# "auto" keeps the customer photo's aspect ratio. Forcing 1024x1024 on a
# portrait photo crops or distorts the person.
COMETAPI_GPTIMAGE_SIZE=auto

# Композит идентичности (сервис mml-vto-segmenter)
#
# Генеративная модель перерисовывает лицо покупателя. Сервис собирает итог из
# фото покупателя и генерации по семантической сегментации и возвращает родное
# лицо. Замерено на цепочке из трёх примерок подряд: без композита косинус
# ArcFace падает в среднем на 0.115 (в худшем случае 0.847 -> 0.677, это уже
# другой человек), с композитом — на 0.007.
#
# ПУСТАЯ СТРОКА = ВЫКЛЮЧЕНО. Это и есть рубильник: убрать значение и
# перезапустить api — быстрее, чем откатывать образ. Сбой сервиса или таймаут
# никогда не роняет примерку: бэкенд отдаёт генерацию как есть и пишет в лог.
VTO_COMPOSITE_URL=
VTO_COMPOSITE_TIMEOUT_SEC=5
# Доля запросов, на которых сервис дополнительно считает косинус ArcFace для
# тревоги. Замер удваивает время композита (0.9 с -> 1.6 с), а нужен он как
# сигнал тренда, не как проверка каждого кадра. 0 = не мерить.
VTO_COMPOSITE_SAMPLE_PCT=10

# Widget
WIDGET_CDN_URL=https://cdn.makemelook.ai/widget

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate Limits (requests per window per IP/session)
RATE_LIMIT_WIDGET_PER_MIN=100
RATE_LIMIT_TRYON_PER_HOUR=20
RATE_LIMIT_TRYON_PER_DAY=50

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Auth (OTP)
AUTH_RESEND_COOLDOWN_SEC=60
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LIMIT_WINDOW_MIN=15

# OAuth — Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth — Yandex
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# OAuth base URL (used to build redirect URIs)
# Production: https://api.makemelook.ai
OAUTH_BASE_URL=http://localhost:8080

