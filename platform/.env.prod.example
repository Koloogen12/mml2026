# Прод-секреты платформы. Скопировать в .env.prod и заполнить. НЕ коммитить.
# Сгенерировать секреты:  openssl rand -hex 32

# Postgres
PG_USER=platform
PG_PASSWORD=CHANGE_ME_strong_password
PG_DB=mml_platform

# Anthropic (чат-оркестратор). ⚠️ ротировать — прежний ключ светился в чате.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# Прокси к Anthropic через Cloudflare Worker (cf-ai-proxy). Пусто = прямой api.anthropic.com.
ANTHROPIC_BASE_URL=https://ai.makemelook.tech
ANTHROPIC_PROXY_KEY=

# Подписи/секреты (по 32+ байта hex)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
CLICK_SIGNING_SECRET=CHANGE_ME_openssl_rand_hex_32
ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Письма (Resend). Домен верифицировать на resend.com/domains.
RESEND_API_KEY=re_...
RESEND_FROM=MakeMeLook <noreply@makemelook.ai>

# Виджет примерки — оставить ПУСТЫМ до координируемого релиза (тогда mock).
WIDGET_BASE_URL=
WIDGET_PROJECT_ID=
WIDGET_API_KEY=

# Объектное хранилище файлов партнёра (лого/размерная сетка). MinIO или S3.
# STORAGE_PUBLIC_URL — база публичных URL (за nginx/CDN). Пусто → загрузки off.
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=partner-assets
STORAGE_PUBLIC_URL=https://cdn.makemelook.ai
STORAGE_USE_SSL=false

# OAuth-вход (Google / Яндекс ID). Пусто → провайдер выключен (кнопка вернёт 501).
# APP_BASE_URL — публичный origin покупателя, из него строится redirect_uri.
APP_BASE_URL=https://makemelook.ai
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
