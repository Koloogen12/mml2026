# Base canonical URL of the site (used by Next.js metadataBase).
BASE_URL=https://b2b.makemelook.ai/

# --- Telegram notification bot (demo-request form) ---
# Get token from @BotFather; chat_id is the supergroup/channel ID.
TG_NOTIFICATION_BOT_ID=
TG_NOTIFICATION_CHAT_ID=
# Optional HTTP(S) proxy for reaching api.telegram.org — required on RU
# hosts where direct egress to Telegram is blocked.
# Example: http://user:pass@host:port
TG_PROXY_URL=

# --- Database (SQLite via Prisma) ---
# Production: file:../data/app.db   — persists under the app working dir.
# Local dev:  file:../data/dev.db
DATABASE_URL=file:../data/dev.db

# --- Phase 2: admin auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
