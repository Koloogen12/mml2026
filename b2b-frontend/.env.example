# Base canonical URL of the site (used by Next.js metadataBase).
BASE_URL=https://b2b.makemelook.ai/

# --- Telegram notification bot (demo-request form) ---
# Get token from @BotFather; chat_id is the supergroup/channel ID.
TG_NOTIFICATION_BOT_ID=
TG_NOTIFICATION_CHAT_ID=
# Optional HTTP(S) proxy for reaching api.telegram.org — required on RU
# hosts where direct egress to Telegram is blocked.
# Example: http://user:pass@host:port
TG_PROXY_URL=

# --- Database (SQLite via Prisma) ---
# Production: file:../data/app.db   — persists under the app working dir.
# Local dev:  file:../data/dev.db
DATABASE_URL=file:../data/dev.db

# --- Phase 2: admin auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# NextAuth v5 uses AUTH_SECRET; keep both in sync.
AUTH_SECRET=

# NEXTAUTH_URL / AUTH_URL СПЕЦИАЛЬНО НЕ ЗАДАЁМ.
#
# Приложение отдаётся на двух именах (b2b.makemelook.ai и makemelook.tech), и
# любой зашитый адрес делает вход на втором из них неработающим. Хуже того:
# NextAuth подменяет им адрес запроса целиком, поэтому при NEXTAUTH_URL=
# https://makemelook.ai (это ДРУГОЙ продукт) переход на /admin уводил человека
# на чужой сайт. Без переменной и с trustHost (см. src/auth.config.ts) адрес
# берётся из самого запроса.
#
# Задавать её стоит только если приложение окажется за прокси, который не
# передаёт X-Forwarded-Host.
